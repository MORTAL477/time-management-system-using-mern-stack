{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Chronos Time Management (Full Stack)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/start.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "serverReadyAction": {
        "pattern": "Local:\\s+(http://localhost:5173/?)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Run Backend Server Only",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/server.js",
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal"
    }
  ]
}
